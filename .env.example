# ---------------------------------------------------------------------------
# TaskTornado environment
# ---------------------------------------------------------------------------
# Leave the Supabase pair blank to run in local demo mode (seeded accounts).
# When both are present the app authenticates against Supabase Auth and reads
# the employee role from public.profiles.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Optional modern publishable key (takes precedence over the anon key name)
# NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Signs the HTTP-only session cookie. Generate with:
#   openssl rand -base64 48
AUTH_SECRET=

# Engineer task creation window (wall-clock time in TASK_WINDOW_TZ)
TASK_WINDOW_START=9
TASK_WINDOW_END=18
TASK_WINDOW_TZ=Asia/Kolkata

# Hard-disable demo logins (recommended once Supabase is configured)
DISABLE_DEMO_LOGIN=false

# ---------------------------------------------------------------------------
# Session-less routes (tickets)
# ---------------------------------------------------------------------------
# The inbound mail hook, the outbox dispatcher and the nightly sweep run without
# a user session. Under `anon`, row-level security returns no rows at all, so
# these routes need the service-role key. Server-only — never NEXT_PUBLIC_.
# SUPABASE_SERVICE_ROLE_KEY=

# Bearer secret a mail worker must present to POST /api/tickets/inbound.
# TICKET_INBOUND_SECRET=

# Bearer secret for POST /api/tickets/outbox. Falls back to CRON_SECRET.
# TICKET_OUTBOX_SECRET=

# Vercel sends this as a bearer token to the nightly sweep. Also accepted by the
# outbox dispatcher if TICKET_OUTBOX_SECRET is not set.
# CRON_SECRET=

# Optional sweep windows, in days.
# TICKET_AUTO_CLOSE_DAYS=7
# TICKET_REMINDER_DAYS=2
