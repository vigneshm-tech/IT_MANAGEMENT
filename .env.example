# ---------------------------------------------------------------------------
# TaskTornado environment
# ---------------------------------------------------------------------------
# Leave the Supabase pair blank to run in local demo mode (seeded accounts).
# When both are present the app authenticates against Supabase Auth and reads
# the employee role from public.profiles.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Optional modern publishable key (takes precedence over the anon key name)
# NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Signs the HTTP-only session cookie. Generate with:
#   openssl rand -base64 48
AUTH_SECRET=

# Engineer task creation window (wall-clock time in TASK_WINDOW_TZ)
TASK_WINDOW_START=9
TASK_WINDOW_END=18
TASK_WINDOW_TZ=Asia/Kolkata

# Hard-disable demo logins (recommended once Supabase is configured)
DISABLE_DEMO_LOGIN=false

# ---------------------------------------------------------------------------
# Better Auth (SSO + managed auth)
# ---------------------------------------------------------------------------
# Secret from the Better Auth dashboard → Project → Environment variables.
BETTER_AUTH_API_KEY=
# Public URL of this deployment (used for callbacks and SSO redirects)
BETTER_AUTH_URL=http://localhost:3000
# Postgres connection for Better Auth's own tables (users, sessions, sso_provider).
# Supabase: use the connection pooler string from Project settings → Database.
DATABASE_URL=
# Optional: only needed while the legacy Supabase Auth path is still enabled
